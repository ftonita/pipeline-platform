{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "access.yml v1: who may touch which section of Vault and Kubernetes",
  "type": "object",
  "required": ["version", "teams"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "teams": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [{ "required": ["group"] }, { "required": ["members"] }],
        "properties": {
          "group": { "type": "string", "minLength": 1, "description": "IdP / OIDC group that carries the team" },
          "members": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/user" } }
        }
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [{ "required": ["team"] }, { "required": ["user"] }],
        "properties": {
          "team": { "$ref": "#/$defs/name" },
          "user": { "$ref": "#/$defs/user" },
          "vault": { "type": "array", "items": { "$ref": "#/$defs/vaultGrant" } },
          "k8s": { "type": "array", "items": { "$ref": "#/$defs/k8sGrant" } }
        }
      }
    },
    "ci": {
      "type": "array",
      "description": "CI projects that read secrets with the Vault rights of a team",
      "items": {
        "type": "object",
        "required": ["project", "team", "audience"],
        "additionalProperties": false,
        "properties": {
          "project": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)+$" },
          "team": { "$ref": "#/$defs/name" },
          "audience": { "type": "string", "pattern": "^https://" },
          "auth_path": { "type": "string", "default": "jwt" }
        }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$" },
    "user": { "type": "string", "pattern": "^[A-Za-z0-9_.@-]{1,100}$" },
    "vaultGrant": {
      "type": "object",
      "required": ["path", "can"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9_./*+-]+$" },
        "can": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["create", "read", "update", "patch", "delete", "list"] }
        },
        "engine": { "enum": ["kv2", "raw"], "default": "kv2", "description": "kv2 inserts /data/ (and /metadata/ for list)" }
      }
    },
    "k8sGrant": {
      "type": "object",
      "required": ["namespace", "role"],
      "additionalProperties": false,
      "properties": {
        "namespace": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" },
        "role": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:.-]*$", "description": "view, edit, admin or a custom ClusterRole" }
      }
    }
  }
}
